#!/bin/bash
# nb-autopilot: switch the needs-you autopilot on and off, and read its report.
#
# While it is on, a Claude Code session that asks the owner a question is told
# to take its own recommended answer and carry on (see hooks/needs-you.sh).
# Logins, payments, merges, publishing, deletions and permission prompts wait.
#
#   nb-autopilot on [HH:MM]   on until the next HH:MM, local time (default 08:00)
#   nb-autopilot off
#   nb-autopilot status
#   nb-autopilot report       decisions since it was last switched on
#   nb-autopilot doctor       check what the popup and the autopilot need
set -u
PATH="$PATH:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin"
DATA="$HOME/.claude/needs-you"
STATE_FILE="$DATA/autopilot.json"
LOG="$DATA/decisions.jsonl"

if [ "${1:-}" != doctor ] && ! command -v jq >/dev/null 2>&1; then
  echo "nb-autopilot: jq is required (brew install jq)" >&2
  exit 1
fi
now=$(date +%s)
saved() { jq -r "$1 // empty" "$STATE_FILE" 2>/dev/null; }
# On means: an end time in the future and at most a day away (as in the hook).
active() {
  local until
  until=$(saved .until_epoch)
  [ "${until:-0}" -gt "$now" ] 2>/dev/null && [ "$(( until - now ))" -le 86400 ]
}
cannot_write() { echo "nb-autopilot: could not write $STATE_FILE" >&2; exit 1; }

case "${1:-status}" in
  on)
    hhmm="${2:-08:00}"
    if ! [[ "$hhmm" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
      echo "nb-autopilot: give the end time as HH:MM, for example 08:00" >&2
      exit 2
    fi
    until=$(date -j -f '%Y-%m-%d %H:%M:%S' "$(date +%Y-%m-%d) $hhmm:00" +%s) || exit 1
    if [ "$until" -le "$now" ]; then
      until=$(date -j -f '%Y-%m-%d %H:%M:%S' "$(date -v+1d +%Y-%m-%d) $hhmm:00" +%s) || exit 1
    fi
    # Switching on again while it runs keeps the start, so the report stays whole.
    since=$now
    active && since=$(saved .since_epoch)
    label=$(date -r "$until" '+%Y-%m-%d %H:%M')
    mkdir -p "$DATA" 2>/dev/null
    if ! { jq -n --argjson u "$until" --argjson s "${since:-$now}" --arg h "$label" \
             '{until_epoch:$u, since_epoch:$s, until:$h}' > "$STATE_FILE.tmp" 2>/dev/null &&
           mv "$STATE_FILE.tmp" "$STATE_FILE" 2>/dev/null; }; then
      cannot_write
    fi
    echo "Autopilot ON until $label"
    ;;
  off)
    if [ -f "$STATE_FILE" ]; then
      # Keep the start time for the report; if that fails, remove the file.
      if ! { jq --argjson n "$now" '.until_epoch = $n' "$STATE_FILE" > "$STATE_FILE.tmp" 2>/dev/null &&
             mv "$STATE_FILE.tmp" "$STATE_FILE" 2>/dev/null; }; then
        rm -f "$STATE_FILE" 2>/dev/null
      fi
      if active; then cannot_write; fi
    fi
    echo "Autopilot OFF"
    ;;
  status)
    if active; then echo "Autopilot ON until $(saved .until)"; else echo "Autopilot OFF"; fi
    ;;
  report)
    since=$(saved .since_epoch)
    lines=""
    [ -s "$LOG" ] && lines=$(jq -r --argjson s "${since:-0}" \
      'select(.ts >= $s) | "\(.time)  \(.title)  \(.decision)"' "$LOG" 2>/dev/null)
    if [ -n "$lines" ]; then printf '%s\n' "$lines"; else echo "No autopilot decisions."; fi
    ;;
  doctor)
    check() { if command -v "$1" >/dev/null 2>&1; then echo "ok       $1"; else echo "$2  $1 ($3)"; fi; }
    check jq "MISSING " "required: brew install jq"
    check osascript "MISSING " "required for the dialog; part of macOS"
    check terminal-notifier "optional" "banners instead of dialogs: brew install terminal-notifier"
    if command -v terminal-notifier >/dev/null 2>&1; then
      echo "         if no banner shows, allow terminal-notifier in System Settings -> Notifications"
    fi
    if command -v jq >/dev/null 2>&1 && active; then
      echo "autopilot ON until $(saved .until)"
    else
      echo "autopilot OFF"
    fi
    echo "data     $DATA"
    ;;
  *)
    echo "usage: nb-autopilot on [HH:MM] | off | status | report | doctor" >&2
    exit 2
    ;;
esac
